{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tkhwang.github.io/workbranch/schema/workbranch-list.schema.json",
  "title": "WorkbranchListDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "root",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "project": {
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "baseRepos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/baseRepo"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "notiCount",
        "repos"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "notiCount": {
          "type": "integer",
          "minimum": 0
        },
        "repos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repo"
          }
        }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "branch",
        "dirty"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "changedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "lastCommitSubject": {
          "type": "string"
        },
        "lastCommitAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "baseRepo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseBranch",
        "branch",
        "present",
        "dirty",
        "changedFiles",
        "remoteAvailable",
        "ahead",
        "behind",
        "inspectionError"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "baseBranch": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "present": {
          "type": "boolean"
        },
        "dirty": {
          "type": "boolean"
        },
        "changedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "remoteAvailable": {
          "type": "boolean"
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "inspectionError": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "invalid-worktree",
            "git-read-failed"
          ]
        }
      }
    }
  }
}
