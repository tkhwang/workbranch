{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tkhwang.github.io/workbranch/schema/workbranch-runtime.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace",
          "provider",
          "sessionId",
          "agentId",
          "turnId",
          "state",
          "observation",
          "reason",
          "prompt",
          "activity",
          "response",
          "outcome",
          "updatedAt",
          "stateChangedAt"
        ],
        "properties": {
          "workspace": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "claude",
              "codex",
              "grok"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "state": {
            "enum": [
              "running",
              "waiting",
              "finished",
              "idle"
            ]
          },
          "observation": {
            "enum": [
              "observed",
              "uncertain",
              "stale"
            ]
          },
          "reason": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          },
          "response": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0
          },
          "stateChangedAt": {
            "type": "integer",
            "minimum": 0
          },
          "transitions": {
            "description": "Optional. The last 24 hours of state changes, led by the change in force at their start; at most 500.",
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "at"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "running",
                    "waiting",
                    "finished",
                    "idle"
                  ]
                },
                "at": {
                  "type": "integer",
                  "minimum": 0
                },
                "outcome": {
                  "type": "string"
                }
              }
            }
          },
          "totals": {
            "description": "Optional. Seconds spent per state across the retained transition log.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "running",
              "waiting",
              "finished"
            ],
            "properties": {
              "running": {
                "type": "integer",
                "minimum": 0
              },
              "waiting": {
                "type": "integer",
                "minimum": 0
              },
              "finished": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
