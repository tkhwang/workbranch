#!/usr/bin/env bash
set -u

PROGRAM=${0##*/}
PROJECT_ROOT=""
CONFIG_FILE=""
PROJECT_NAME=""
BASE_DIR=""
BRANCH_PREFIX=""
REPO_NAMES=()
REPO_URLS=()
REPO_BASE_BRANCHES=()
CREATED_PATHS=()
CREATED_WORKTREES=()
CREATED_WORKTREE_BASES=()
CREATED_BRANCH_REPOS=()
CREATED_BRANCH_NAMES=()
FILTER_REPO=""
ARGS=()

info() { printf '[*] %s\n' "$*"; }
success() { printf '[+] %s\n' "$*"; }
die() { printf '[-] Error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<USAGE
Usage:
  monotree <command> [args]

Workspace:
  config            Create .monotree.config without cloning repos
  init              Initialize a monotree project
  list              List configured repos and task workspaces
  status            Show clean/dirty status for base and task worktrees
  add <task>        Create a task workspace
  remove <task>     Remove task worktrees without deleting branches

Git:
  pull              Pull remote base branches into main worktrees
  rebase            Rebase every task workspace onto remote base branches
  rebase <task>     Rebase one task workspace onto remote base branches
  push              Push base branches to origin
  push <task>       Push task branches to origin
  merge <task>      Fast-forward base branches from task branches
  --repo <repo>     Limit supported commands to one repo

Other:
  help              Show this help
USAGE
}
is_safe_name() {
  [ -n "$1" ] || return 1
  case "$1" in
    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

has_whitespace() {
  case "$1" in
    *[[:space:]]*) return 0 ;;
    *) return 1 ;;
  esac
}

validate_safe_name() {
  label=$1
  value=$2
  is_safe_name "$value" || die "invalid $label '$value' (expected [A-Za-z0-9._-]+)"
}

validate_nonempty_no_space() {
  label=$1
  value=$2
  [ -n "$value" ] || die "invalid $label: empty value"
  if has_whitespace "$value"; then
    die "invalid $label '$value': whitespace is not supported"
  fi
}

repo_count() { printf '%s' "${#REPO_NAMES[@]}"; }

repo_name_at() { eval "printf '%s' \"\${REPO_NAMES[$1]}\""; }
repo_url_at() { eval "printf '%s' \"\${REPO_URLS[$1]}\""; }
repo_base_branch_at() { eval "printf '%s' \"\${REPO_BASE_BRANCHES[$1]}\""; }

repo_index_by_name() {
  needle=$1
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    if [ "$(repo_name_at "$i")" = "$needle" ]; then
      printf '%s' "$i"
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

parse_repo_option() {
  FILTER_REPO=""
  ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)
        [ $# -ge 2 ] || die "missing value for --repo"
        FILTER_REPO=$2
        validate_safe_name "repo" "$FILTER_REPO"
        shift 2
        ;;
      --repo=*)
        FILTER_REPO=${1#--repo=}
        validate_safe_name "repo" "$FILTER_REPO"
        shift
        ;;
      *)
        ARGS[${#ARGS[@]}]=$1
        shift
        ;;
    esac
  done

  if [ -n "$FILTER_REPO" ]; then
    repo_index_by_name "$FILTER_REPO" >/dev/null || die "unknown repo: $FILTER_REPO"
  fi
}

repo_matches_filter() {
  [ -z "$FILTER_REPO" ] || [ "$1" = "$FILTER_REPO" ]
}

add_repo_config() {
  name=$1
  url=$2
  base_branch=${3:-}
  validate_safe_name "repo name" "$name"
  validate_nonempty_no_space "git-url" "$url"
  if [ -n "$base_branch" ]; then
    validate_nonempty_no_space "base-branch" "$base_branch"
  fi
  if repo_index_by_name "$name" >/dev/null; then
    die "duplicate repo '$name' in config"
  fi
  REPO_NAMES[${#REPO_NAMES[@]}]=$name
  REPO_URLS[${#REPO_URLS[@]}]=$url
  REPO_BASE_BRANCHES[${#REPO_BASE_BRANCHES[@]}]=$base_branch
}

set_repo_base_branch() {
  name=$1
  base_branch=$2
  validate_nonempty_no_space "base-branch" "$base_branch"
  idx=$(repo_index_by_name "$name") || die "base branch references unknown repo '$name'"
  current=$(repo_base_branch_at "$idx")
  if [ -n "$current" ]; then
    [ "$current" = "$base_branch" ] || die "conflicting base branch for repo '$name': $current vs $base_branch"
    return 0
  fi
  REPO_BASE_BRANCHES[$idx]=$base_branch
}

reset_config() {
  PROJECT_NAME=""
  BASE_DIR=""
  BRANCH_PREFIX=""
  REPO_NAMES=()
  REPO_URLS=()
  REPO_BASE_BRANCHES=()
}

parse_config() {
  file=$1
  [ -f "$file" ] || die "config not found: $file"
  reset_config
  line_no=0
  while IFS= read -r raw_line || [ -n "$raw_line" ]; do
    line_no=$((line_no + 1))
    # trim leading/trailing whitespace using awk-compatible shell expansion avoidance
    line=$(printf '%s' "$raw_line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac

    # shell word splitting is intentional: config values cannot contain whitespace.
    set -- $line
    directive=$1
    case "$directive" in
      PROJECT_NAME)
        [ $# -eq 2 ] || die "invalid config line $line_no: PROJECT_NAME expects 1 value"
        [ -z "$PROJECT_NAME" ] || die "duplicate PROJECT_NAME directive in config"
        validate_safe_name "PROJECT_NAME" "$2"
        PROJECT_NAME=$2
        ;;
      MAIN_WORKTREES_DIR)
        [ $# -eq 2 ] || die "invalid config line $line_no: MAIN_WORKTREES_DIR expects 1 value"
        [ -z "$BASE_DIR" ] || die "duplicate MAIN_WORKTREES_DIR directive in config"
        validate_safe_name "MAIN_WORKTREES_DIR" "$2"
        BASE_DIR=$2
        ;;
      BRANCH_PREFIX)
        [ $# -eq 2 ] || die "invalid config line $line_no: BRANCH_PREFIX expects 1 value"
        [ -z "$BRANCH_PREFIX" ] || die "duplicate BRANCH_PREFIX directive in config"
        validate_nonempty_no_space "BRANCH_PREFIX" "$2"
        BRANCH_PREFIX=$2
        ;;
      REPO)
        if [ $# -eq 3 ]; then
          add_repo_config "$2" "$3"
        elif [ $# -eq 4 ]; then
          add_repo_config "$2" "$3" "$4"
        else
          die "invalid config line $line_no: REPO expects 2 or 3 values"
        fi
        ;;
      WORKFLOW)
        if [ $# -eq 4 ] || [ $# -eq 5 ]; then
          set_repo_base_branch "$2" "$4"
        else
          die "invalid config line $line_no: WORKFLOW expects 3 or 4 values"
        fi
        ;;
      *)
        die "unknown directive '$directive' in config line $line_no"
        ;;
    esac
  done < "$file"

  [ -n "$PROJECT_NAME" ] || die "missing PROJECT_NAME directive in config"
  [ -n "$BASE_DIR" ] || die "missing MAIN_WORKTREES_DIR directive in config"
  [ -n "$BRANCH_PREFIX" ] || die "missing BRANCH_PREFIX directive in config"
  [ ${#REPO_NAMES[@]} -gt 0 ] || die "config must define at least one repo"
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    [ -n "$(repo_base_branch_at "$i")" ] || die "missing base branch for repo '$name'"
    i=$((i + 1))
  done
}

find_project_root() {
  dir=$(pwd -P)
  while :; do
    if [ -f "$dir/.monotree.config" ]; then
      PROJECT_ROOT=$dir
      CONFIG_FILE="$dir/.monotree.config"
      return 0
    fi
    [ "$dir" = "/" ] && return 1
    dir=$(dirname "$dir")
  done
}

require_project() {
  find_project_root || die "not inside a monotree project (missing .monotree.config)"
  parse_config "$CONFIG_FILE"
}

base_repo_path() { printf '%s/%s/%s' "$PROJECT_ROOT" "$BASE_DIR" "$1"; }
task_repo_path() { printf '%s/%s/%s' "$PROJECT_ROOT" "$1" "$2"; }
feature_branch_for_task() { printf '%s/%s' "$BRANCH_PREFIX" "$1"; }
stacked_branch_for_task() {
  parent=$1
  task=$2
  printf '%s-%s' "$parent" "$task"
}
repo_task_branch_at() {
  index=$1
  task=$2
  base_branch=$(repo_base_branch_at "$index")
  case "$base_branch" in
    "$BRANCH_PREFIX"/*) stacked_branch_for_task "$base_branch" "$task" ;;
    *) feature_branch_for_task "$task" ;;
  esac
}

is_git_dirty() {
  path=$1
  [ -d "$path" ] || return 1
  status=$(git -C "$path" status --porcelain 2>/dev/null) || return 1
  [ -n "$status" ]
}

ensure_clean_worktree() {
  path=$1
  if is_git_dirty "$path"; then
    die "dirty worktree: $path"
  fi
}

branch_exists() {
  repo_path=$1
  branch=$2
  git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch"
}

rollback_created() {
  # Remove command-created worktrees first, then command-created branches, then plain paths.
  i=$((${#CREATED_WORKTREES[@]} - 1))
  while [ $i -ge 0 ]; do
    wt=${CREATED_WORKTREES[$i]}
    if [ -e "$wt" ]; then
      base=${CREATED_WORKTREE_BASES[$i]}
      git -C "$base" worktree remove "$wt" >/dev/null 2>&1 || rm -rf "$wt"
    fi
    i=$((i - 1))
  done

  i=$((${#CREATED_BRANCH_REPOS[@]} - 1))
  while [ $i -ge 0 ]; do
    repo=${CREATED_BRANCH_REPOS[$i]}
    branch=${CREATED_BRANCH_NAMES[$i]}
    if [ -d "$repo/.git" ] && branch_exists "$repo" "$branch"; then
      git -C "$repo" branch -D "$branch" >/dev/null 2>&1 || true
    fi
    i=$((i - 1))
  done

  i=$((${#CREATED_PATHS[@]} - 1))
  while [ $i -ge 0 ]; do
    path=${CREATED_PATHS[$i]}
    [ -e "$path" ] && rm -rf "$path"
    i=$((i - 1))
  done
}

fail_with_rollback() {
  msg=$1
  rollback_created
  die "$msg"
}

track_path() { CREATED_PATHS[${#CREATED_PATHS[@]}]=$1; }
track_worktree() {
  CREATED_WORKTREES[${#CREATED_WORKTREES[@]}]=$1
  CREATED_WORKTREE_BASES[${#CREATED_WORKTREE_BASES[@]}]=$2
}
track_branch() {
  CREATED_BRANCH_REPOS[${#CREATED_BRANCH_REPOS[@]}]=$1
  CREATED_BRANCH_NAMES[${#CREATED_BRANCH_NAMES[@]}]=$2
}

clone_base_repos() {
  base_root="$PROJECT_ROOT/$BASE_DIR"
  if [ ! -e "$base_root" ]; then
    mkdir -p "$base_root" || fail_with_rollback "failed to create base directory: $base_root"
    track_path "$base_root"
  else
    [ -d "$base_root" ] || die "base path exists but is not a directory: $base_root"
  fi
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    url=$(repo_url_at "$i")
    branch=$(repo_base_branch_at "$i")
    target=$(base_repo_path "$name")
    if [ -e "$target" ]; then
      info "Base repo exists: $BASE_DIR/$name"
    else
      clone_output=$(git clone --branch "$branch" "$url" "$target" 2>&1)
      clone_status=$?
      if [ $clone_status -ne 0 ]; then
        fail_with_rollback "failed to clone repo '$name' from $url branch $branch
$clone_output"
      fi
      track_path "$target"
      success "Cloned: $BASE_DIR/$name"
    fi
    i=$((i + 1))
  done
}

write_config() {
  file=$1
  mkdir -p "$(dirname "$file")" || die "failed to create config directory"
  {
    printf '# Monotree config
'
    printf '# You may edit this file manually.
'
    printf '# This file is read by monotree. It is not a shell script.
'
    printf '#
'
    printf '# Be careful changing MAIN_WORKTREES_DIR, BRANCH_PREFIX, or REPO after worktrees exist.
'
    printf '\n'
    printf 'PROJECT_NAME %s\n' "$PROJECT_NAME"
    printf 'MAIN_WORKTREES_DIR %s\n' "$BASE_DIR"
    printf 'BRANCH_PREFIX %s\n' "$BRANCH_PREFIX"
    printf '\n'
    printf '# REPO <name> <git-url> <base-branch>\n'
    i=0
    while [ $i -lt ${#REPO_NAMES[@]} ]; do
      printf 'REPO %s %s %s\n' "$(repo_name_at "$i")" "$(repo_url_at "$i")" "$(repo_base_branch_at "$i")"
      i=$((i + 1))
    done
  } > "$file" || die "failed to write config: $file"
}
prompt_read() {
  prompt=$1
  value=""
  if [ -t 0 ]; then
    # Use readline for interactive editing when a real terminal is attached.
    IFS= read -r -e -p "$prompt" value || :
  else
    printf '%s' "$prompt" >&2
    IFS= read -r value || :
  fi
  printf '%s' "$value"
}

prompt_with_default() {
  prompt=$1
  default=$2
  value=$(prompt_read "[*] $prompt [$default]: ")
  if [ -z "$value" ]; then
    printf '%s' "$default"
  else
    printf '%s' "$value"
  fi
}

prompt_required() {
  prompt=$1
  value=""
  while [ -z "$value" ]; do
    value=$(prompt_read "[*] $prompt: ")
    [ -n "$value" ] || printf '[-] %s is required.
' "$prompt" >&2
  done
  printf '%s' "$value"
}

expand_path() {
  value=$1
  case "$value" in
    ".") pwd -P ;;
    "~") printf '%s' "$HOME" ;;
    "~/"*) printf '%s/%s' "$HOME" "${value#~/}" ;;
    /*) printf '%s' "$value" ;;
    *) printf '%s/%s' "$(pwd -P)" "$value" ;;
  esac
}

cmd_init_interactive() {
  clone_after=${1:-yes}
  reset_config
  info "Create a new monotree project"
  printf '
' >&2
  info "Before monotree"
  cat >&2 <<'BEFORE'
    frontend                    // repo
    └── AI agent                // separate session/context

    backend                     // repo
    └── AI agent                // separate session/context

    Problem: separate agents do not share context, session, or file search.
BEFORE
  printf '
' >&2
  info "After monotree"
  cat >&2 <<'AFTER'
    fullstack                     // monotree project
    ├── .monotree.config          // config
    ├── _base                     // main worktrees
    │   ├── frontend              // main worktree: frontend
    │   └── backend               // main worktree: backend
    └── login                     // task workspace
        ├── frontend              // linked worktree: frontend
        ├── backend               // linked worktree: backend
        └── <run AI agent here>   // cd login && run codex, claude code, ...

    Result: one task workspace, one AI session, repo-local paths.
AFTER
  printf '
' >&2
  info "Setup guide"
  printf '    Project name      directory name for this monotree workspace
' >&2
  printf '    Main worktrees    directory for each repo main worktree
' >&2
  printf '    Default main      default branch for repo main worktrees
' >&2
  printf '    Branch prefix     task branch prefix, e.g. feature/login
' >&2
  printf '    Repositories      Git repos included in each task workspace
' >&2
  printf '
[*] Press Enter to continue...' >&2
  IFS= read -r _continue || _continue=""
  printf '

' >&2
  info "Project"
  target_dir_input=$(prompt_with_default "Target directory" ".")
  TARGET_DIR=$(expand_path "$target_dir_input")
  PROJECT_NAME=$(prompt_with_default "Project name" "fullstack")
  validate_safe_name "project" "$PROJECT_NAME"
  BASE_DIR=$(prompt_with_default "Main worktrees directory" "_base")
  validate_safe_name "MAIN_WORKTREES_DIR" "$BASE_DIR"
  default_branch=$(prompt_with_default "Default main branch" "main")
  validate_nonempty_no_space "default base branch" "$default_branch"
  BRANCH_PREFIX=$(prompt_with_default "Branch prefix" "feature")
  validate_nonempty_no_space "branch_prefix" "$BRANCH_PREFIX"

  printf '
' >&2
  info "Repositories"

  repo_number=1
  while :; do
    printf '
' >&2
    info "Repo #$repo_number"
    repo_name=$(prompt_required "Repository name")
    validate_safe_name "repo name" "$repo_name"
    repo_url=$(prompt_required "Git URL")
    validate_nonempty_no_space "git-url" "$repo_url"
    repo_branch=$(prompt_with_default "Base branch" "$default_branch")
    add_repo_config "$repo_name" "$repo_url" "$repo_branch"
    printf '[*] Add another repo? [y/N]: ' >&2
    IFS= read -r answer || answer=""
    case "$answer" in
      y|Y|yes|YES) repo_number=$((repo_number + 1)); continue ;;
      *) break ;;
    esac
  done

  printf '
' >&2
  info "Summary"
  info "Project: $PROJECT_NAME"
  info "Main worktrees dir: $BASE_DIR"
  info "Branch prefix: $BRANCH_PREFIX"
  info "Repositories:"
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    info "  - $(repo_name_at "$i") $(repo_url_at "$i") base=$(repo_base_branch_at "$i")"
    i=$((i + 1))
  done
  printf '
' >&2
  if [ "$clone_after" = "yes" ]; then
    info "Creating project..."
  else
    info "Writing config..."
  fi

  PROJECT_ROOT="$TARGET_DIR/$PROJECT_NAME"
  [ ! -e "$PROJECT_ROOT" ] || die "project directory already exists: $PROJECT_ROOT"
  mkdir -p "$PROJECT_ROOT" || die "failed to create project directory: $PROJECT_ROOT"
  track_path "$PROJECT_ROOT"
  CONFIG_FILE="$PROJECT_ROOT/.monotree.config"
  write_config "$CONFIG_FILE"
  if [ "$clone_after" = "yes" ]; then
    clone_base_repos
    success "Initialized monotree project: $PROJECT_ROOT"
  else
    success "Config written: $CONFIG_FILE"
  fi
}

cmd_config() {
  [ $# -eq 0 ] || die "usage: monotree config"
  CREATED_PATHS=()
  CREATED_WORKTREES=()
  CREATED_WORKTREE_BASES=()
  CREATED_BRANCH_REPOS=()
  CREATED_BRANCH_NAMES=()
  cmd_init_interactive no
}

cmd_init() {
  [ $# -eq 0 ] || die "usage: monotree init"
  CREATED_PATHS=()
  CREATED_WORKTREES=()
  CREATED_WORKTREE_BASES=()
  CREATED_BRANCH_REPOS=()
  CREATED_BRANCH_NAMES=()
  if [ -f ".monotree.config" ]; then
    PROJECT_ROOT=$(pwd -P)
    CONFIG_FILE="$PROJECT_ROOT/.monotree.config"
    parse_config "$CONFIG_FILE"
    clone_base_repos
    success "Initialized monotree project: $PROJECT_ROOT"
  else
    cmd_init_interactive yes
  fi
}

cmd_add() {
  [ $# -eq 1 ] || die "usage: monotree add <task>"
  task=$1
  validate_safe_name "task" "$task"
  require_project
  CREATED_PATHS=()
  CREATED_WORKTREES=()
  CREATED_WORKTREE_BASES=()
  CREATED_BRANCH_REPOS=()
  CREATED_BRANCH_NAMES=()
  task_dir="$PROJECT_ROOT/$task"
  [ ! -e "$task_dir" ] || die "task directory already exists: $task_dir"

  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    base=$(base_repo_path "$name")
    branch=$(repo_task_branch_at "$i" "$task")
    [ -d "$base/.git" ] || die "base repo missing for '$name': $base"
    if branch_exists "$base" "$branch"; then
      die "branch already exists for repo '$name': $branch"
    fi
    i=$((i + 1))
  done

  mkdir -p "$task_dir" || die "failed to create task directory: $task_dir"
  track_path "$task_dir"

  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    base=$(base_repo_path "$name")
    base_branch=$(repo_base_branch_at "$i")
    branch=$(repo_task_branch_at "$i" "$task")
    target=$(task_repo_path "$task" "$name")
    git -C "$base" fetch origin >/dev/null 2>&1 || fail_with_rollback "failed to fetch repo '$name'"
    git -C "$base" worktree add "$target" -b "$branch" "origin/$base_branch" >/dev/null 2>&1 || fail_with_rollback "failed to create worktree for repo '$name'"
    track_worktree "$target" "$base"
    track_branch "$base" "$branch"
    success "Created: $task/$name"
    i=$((i + 1))
  done
}

branch_or_unknown() {
  path=$1
  if [ -d "$path" ]; then
    git -C "$path" branch --show-current 2>/dev/null || printf '?'
  else
    printf 'missing'
  fi
}

worktree_status_label() {
  path=$1
  [ -d "$path" ] || { printf 'missing'; return 0; }
  status=$(git -C "$path" status --porcelain 2>/dev/null) || { printf 'missing'; return 0; }
  [ -n "$status" ] || { printf 'clean'; return 0; }

  modified=0
  untracked=0
  old_ifs=$IFS
  IFS='
'
  for line in $status; do
    case "$line" in
      \?\?\ *) untracked=1 ;;
      *) modified=1 ;;
    esac
  done
  IFS=$old_ifs

  if [ $modified -eq 1 ] && [ $untracked -eq 1 ]; then
    printf 'modified, untracked'
  elif [ $modified -eq 1 ]; then
    printf 'modified'
  else
    printf 'untracked'
  fi
}

print_status_item() {
  name=$1
  branch=$2
  state=$3
  printf '    %-11s %-16s %s\n' "$name" "$branch" "$state"
}

ensure_current_branch() {
  path=$1
  expected=$2
  actual=$(branch_or_unknown "$path")
  [ "$actual" = "$expected" ] || die "unexpected branch in $path: expected $expected, got $actual"
}

cmd_list() {
  require_project
  info "Project: $PROJECT_NAME"
  info "Base: $BASE_DIR"
  info "Repos:"
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    branch=$(repo_base_branch_at "$i")
    current=$(branch_or_unknown "$(base_repo_path "$name")")
    info "  Repo: $name base=$branch current=$current"
    i=$((i + 1))
  done
  info "Tasks:"
  found=0
  for path in "$PROJECT_ROOT"/*; do
    [ -d "$path" ] || continue
    dir_name=${path##*/}
    [ "$dir_name" = "$BASE_DIR" ] && continue
    case "$dir_name" in .*) continue ;; esac
    task_has_repo=0
    i=0
    while [ $i -lt ${#REPO_NAMES[@]} ]; do
      name=$(repo_name_at "$i")
      [ -d "$path/$name" ] && task_has_repo=1
      i=$((i + 1))
    done
    [ $task_has_repo -eq 1 ] || continue
    found=1
    info "  Task: $dir_name"
    i=0
    while [ $i -lt ${#REPO_NAMES[@]} ]; do
      name=$(repo_name_at "$i")
      current=$(branch_or_unknown "$path/$name")
      info "    Repo: $name current=$current"
      i=$((i + 1))
    done
  done
  [ $found -eq 1 ] || info "  (none)"
}

cmd_status() {
  require_project
  parse_repo_option "$@"
  [ ${#ARGS[@]} -eq 0 ] || die "usage: monotree status [--repo <repo>]"

  info "Base worktrees"
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    repo_matches_filter "$name" || { i=$((i + 1)); continue; }
    path=$(base_repo_path "$name")
    print_status_item "$name" "$(branch_or_unknown "$path")" "$(worktree_status_label "$path")"
    i=$((i + 1))
  done

  printf '\n'
  info "Task workspaces"
  found=0
  for path in "$PROJECT_ROOT"/*; do
    is_task_workspace_path "$path" || continue
    found=1
    task=${path##*/}
    info "$task"
    i=0
    while [ $i -lt ${#REPO_NAMES[@]} ]; do
      name=$(repo_name_at "$i")
      repo_matches_filter "$name" || { i=$((i + 1)); continue; }
      repo_path="$path/$name"
      [ -d "$repo_path" ] || { i=$((i + 1)); continue; }
      print_status_item "$name" "$(branch_or_unknown "$repo_path")" "$(worktree_status_label "$repo_path")"
      i=$((i + 1))
    done
  done
  [ $found -eq 1 ] || info "(none)"
}

is_task_workspace_path() {
  path=$1
  [ -d "$path" ] || return 1
  dir_name=${path##*/}
  [ "$dir_name" = "$BASE_DIR" ] && return 1
  case "$dir_name" in .*) return 1 ;; esac

  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    [ -d "$path/$name" ] && return 0
    i=$((i + 1))
  done
  return 1
}

cmd_pull() {
  require_project
  parse_repo_option "$@"
  [ ${#ARGS[@]} -eq 0 ] || die "usage: monotree pull [--repo <repo>]"
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    repo_matches_filter "$name" || { i=$((i + 1)); continue; }
    base=$(base_repo_path "$name")
    [ -d "$base/.git" ] || die "base repo missing for '$name': $base"
    ensure_clean_worktree "$base"
    i=$((i + 1))
  done

  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    repo_matches_filter "$name" || { i=$((i + 1)); continue; }
    branch=$(repo_base_branch_at "$i")
    base=$(base_repo_path "$name")
    git -C "$base" pull --ff-only origin "$branch" || die "failed to pull repo '$name'"
    i=$((i + 1))
  done
}

require_task_repos_clean() {
  task=$1
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    path=$(task_repo_path "$task" "$name")
    [ -d "$path" ] || die "task repo missing for '$name': $path"
    ensure_clean_worktree "$path"
    i=$((i + 1))
  done
}

rebase_task() {
  task=$1
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    repo_matches_filter "$name" || { i=$((i + 1)); continue; }
    branch=$(repo_base_branch_at "$i")
    path=$(task_repo_path "$task" "$name")
    [ -d "$path" ] || die "task repo missing for '$name': $path"
    ensure_clean_worktree "$path"
    git -C "$path" fetch origin || die "failed to fetch task repo '$name': $path"
    git -C "$path" rebase "origin/$branch" || die "rebase failed in $path; resolve conflicts manually"
    success "Rebased: $task/$name"
    i=$((i + 1))
  done
}

cmd_rebase() {
  require_project
  parse_repo_option "$@"
  [ ${#ARGS[@]} -le 1 ] || die "usage: monotree rebase [task] [--repo <repo>]"
  if [ ${#ARGS[@]} -eq 1 ] && [ "$(eval "printf '%s' \"\${ARGS[0]}\"")" != "--all" ]; then
    task=$(eval "printf '%s' \"\${ARGS[0]}\"")
    validate_safe_name "task" "$task"
    rebase_task "$task"
    return 0
  fi

  found=0
  for path in "$PROJECT_ROOT"/*; do
    is_task_workspace_path "$path" || continue
    found=1
    rebase_task "${path##*/}"
  done
  [ $found -eq 1 ] || die "no task workspaces to rebase"
}

cmd_push_base() {
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    repo_matches_filter "$name" || { i=$((i + 1)); continue; }
    branch=$(repo_base_branch_at "$i")
    base=$(base_repo_path "$name")
    [ -d "$base/.git" ] || die "base repo missing for '$name': $base"
    ensure_current_branch "$base" "$branch"
    git -C "$base" push origin "$branch" || die "failed to push base branch for repo '$name': $branch"
    i=$((i + 1))
  done
}

cmd_push_task() {
  task=$1
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    repo_matches_filter "$name" || { i=$((i + 1)); continue; }
    branch=$(repo_task_branch_at "$i" "$task")
    path=$(task_repo_path "$task" "$name")
    [ -d "$path" ] || die "task repo missing for '$name': $path"
    ensure_current_branch "$path" "$branch"
    git -C "$path" push -u origin "$branch" || die "failed to push repo '$name'"
    i=$((i + 1))
  done
}

cmd_push() {
  require_project
  parse_repo_option "$@"
  [ ${#ARGS[@]} -le 1 ] || die "usage: monotree push [task] [--repo <repo>]"
  if [ ${#ARGS[@]} -eq 0 ]; then
    cmd_push_base
    return 0
  fi

  task=$(eval "printf '%s' \"\${ARGS[0]}\"")
  validate_safe_name "task" "$task"
  cmd_push_task "$task"
}

cmd_merge() {
  require_project
  parse_repo_option "$@"
  [ ${#ARGS[@]} -eq 1 ] || die "usage: monotree merge <task> [--repo <repo>]"
  task=$(eval "printf '%s' \"\${ARGS[0]}\"")
  validate_safe_name "task" "$task"

  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    repo_matches_filter "$name" || { i=$((i + 1)); continue; }
    base=$(base_repo_path "$name")
    path=$(task_repo_path "$task" "$name")
    branch=$(repo_task_branch_at "$i" "$task")
    base_branch=$(repo_base_branch_at "$i")
    [ -d "$path" ] || die "task repo missing for '$name': $path"
    ensure_current_branch "$path" "$branch"
    ensure_clean_worktree "$path"
    [ -d "$base/.git" ] || die "base repo missing for '$name': $base"
    ensure_clean_worktree "$base"
    git -C "$base" fetch origin || die "failed to fetch base repo '$name': $base"
    git -C "$base" show-ref --verify --quiet "refs/remotes/origin/$base_branch" || die "remote base branch missing for repo '$name': origin/$base_branch"
    i=$((i + 1))
  done

  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    repo_matches_filter "$name" || { i=$((i + 1)); continue; }
    base=$(base_repo_path "$name")
    branch=$(repo_task_branch_at "$i" "$task")
    base_branch=$(repo_base_branch_at "$i")
    git -C "$base" checkout "$base_branch" >/dev/null 2>&1 || die "failed to checkout base branch for repo '$name': $base_branch"
    ensure_current_branch "$base" "$base_branch"
    git -C "$base" pull --ff-only origin "$base_branch" || die "failed to update base branch for repo '$name': $base_branch"
    git -C "$base" merge --ff-only "$branch" || die "failed to merge repo '$name'; run monotree rebase $task and resolve conflicts first"
    success "Merged: $task/$name -> $base_branch"
    i=$((i + 1))
  done
}

cmd_remove() {
  [ $# -eq 1 ] || die "usage: monotree remove <task>"
  task=$1
  validate_safe_name "task" "$task"
  require_project
  require_task_repos_clean "$task"
  i=0
  while [ $i -lt ${#REPO_NAMES[@]} ]; do
    name=$(repo_name_at "$i")
    path=$(task_repo_path "$task" "$name")
    [ -d "$path" ] || die "task repo missing for '$name': $path"
    base=$(base_repo_path "$name")
    git -C "$base" worktree remove "$path" || die "failed to remove worktree: $path"
    i=$((i + 1))
  done
  rmdir "$PROJECT_ROOT/$task" 2>/dev/null || true
}

main() {
  cmd=${1:-help}
  if [ $# -gt 0 ]; then shift; fi
  case "$cmd" in
    config) cmd_config "$@" ;;
    init) cmd_init "$@" ;;
    add) cmd_add "$@" ;;
    list) cmd_list "$@" ;;
    status) cmd_status "$@" ;;
    pull) cmd_pull "$@" ;;
    rebase) cmd_rebase "$@" ;;
    push) cmd_push "$@" ;;
    merge) cmd_merge "$@" ;;
    remove) cmd_remove "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $cmd" ;;
  esac
}

main "$@"
