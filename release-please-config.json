{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "package-name": "workbranch",
      "component": "workbranch",
      "include-component-in-tag": false,
      "exclude-paths": [
        "apps/workbranch-companion/**",
        "packages/contract/**",
        ".github/**",
        "docs/**",
        "README.md",
        "README.ko.md",
        "release-please-config.json",
        ".release-please-manifest.json"
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "apps/workbranch-cli/bin/workbranch"
        },
        {
          "type": "generic",
          "path": "bin/workbranch"
        }
      ]
    },
    "apps/workbranch-companion": {
      "package-name": "workbranch-companion",
      "component": "workbranch-companion",
      "release-type": "simple",
      "include-component-in-tag": true,
      "extra-files": [
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name==\"workbranch-companion\")].version"
        }
      ]
    }
  }
}
