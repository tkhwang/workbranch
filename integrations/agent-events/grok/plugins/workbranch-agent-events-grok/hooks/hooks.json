{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/collect.sh\"",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/collect.sh\"",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/collect.sh\"",
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/collect.sh\"",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/collect.sh\"",
            "timeout": 1
          }
        ]
      }
