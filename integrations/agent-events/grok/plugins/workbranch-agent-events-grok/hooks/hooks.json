    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/collect.sh\"",
            "timeout": 1
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/collect.sh\"",
            "timeout": 1
          }
        ]
      }
